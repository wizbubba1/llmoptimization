# LLM Asset Oracle - Environment Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# LLM API KEYS (at least one required)
# =============================================================================

# OpenAI API Key (for GPT-4, GPT-3.5)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google AI API Key (for Gemini)
GOOGLE_API_KEY=your-google-ai-key-here

# Together AI API Key (for Llama, Mixtral, etc.)
TOGETHER_API_KEY=your-together-ai-key-here

# Mistral API Key
MISTRAL_API_KEY=your-mistral-key-here

# =============================================================================
# DISCORD BOT CONFIGURATION
# =============================================================================

# Discord Bot Token (required for Discord integration)
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Discord Application ID
DISCORD_APPLICATION_ID=your-application-id

# Guild IDs for slash command registration (comma-separated, optional)
# Leave empty for global commands (takes up to 1 hour to propagate)
DISCORD_GUILD_IDS=

# =============================================================================
# MARKET DATA (optional - uses free APIs by default)
# =============================================================================

# Alpha Vantage API Key (optional, for enhanced stock data)
ALPHA_VANTAGE_API_KEY=

# CoinGecko API Key (optional, for enhanced crypto data)
COINGECKO_API_KEY=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Database path (SQLite)
DATABASE_PATH=./data/llm_oracle.db

# Cache TTL in seconds (how long to cache LLM responses)
CACHE_TTL_SECONDS=3600

# Rate limiting (requests per minute per LLM provider)
RATE_LIMIT_RPM=20

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable/disable specific LLM providers (comma-separated)
# Available: openai,anthropic,google,together,mistral
ENABLED_PROVIDERS=openai,anthropic,google

# Number of models to query for consensus (more = more scientific but slower/costlier)
CONSENSUS_MODEL_COUNT=3
