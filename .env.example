# LLM Asset Oracle - Environment Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# OPENROUTER (RECOMMENDED - Single API for 100+ models)
# =============================================================================

# OpenRouter API Key - Get one at https://openrouter.ai/
# This is the ONLY key you need to query 20+ AI models!
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# =============================================================================
# ORACLE SETTINGS
# =============================================================================

# Number of models to query (default: 15, max: 20)
# More models = more scientific consensus but higher cost
ORACLE_MODEL_COUNT=15

# Budget mode - prefer cheaper models (default: false)
ORACLE_BUDGET_MODE=false

# Max concurrent requests to OpenRouter (default: 10)
ORACLE_MAX_CONCURRENT=10

# =============================================================================
# DISCORD BOT CONFIGURATION
# =============================================================================

# Discord Bot Token (required for Discord integration)
# Create a bot at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Discord Application ID (optional)
DISCORD_APPLICATION_ID=your-application-id

# Guild IDs for instant slash command sync (comma-separated, optional)
# Leave empty for global commands (takes ~1 hour to propagate)
DISCORD_GUILD_IDS=

# =============================================================================
# MARKET DATA (optional - uses free APIs by default)
# =============================================================================

# CoinGecko API Key (optional, for enhanced crypto data)
# Free tier works fine, paid tier has higher rate limits
COINGECKO_API_KEY=

# Alpha Vantage API Key (optional, for enhanced stock data)
ALPHA_VANTAGE_API_KEY=

# =============================================================================
# LEGACY: INDIVIDUAL LLM API KEYS (not needed with OpenRouter)
# =============================================================================
# These are only used if you want to bypass OpenRouter and use direct APIs

# OpenAI API Key (for GPT-4, GPT-3.5)
# OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (for Claude)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google AI API Key (for Gemini)
# GOOGLE_API_KEY=your-google-ai-key-here

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Database path (SQLite for caching)
DATABASE_PATH=./data/llm_oracle.db

# Cache TTL in seconds (how long to cache LLM responses)
CACHE_TTL_SECONDS=3600

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
